<section class="hero-section rounded-4 p-4 mb-4 text-white">
  <h1 class="fw-bold mb-2">Find Your Perfect Stay</h1>
  <p class="mb-0">Search hotels by destination, budget, and ratings.</p>
</section>

<div class="card mb-4 shadow-sm">
  <div class="card-body">
    <form class="row g-3" method="GET" action="/hotels">
      <div class="col-md-4">
        <input class="form-control" type="text" name="location" placeholder="Location" value="<%= query.location || '' %>">
      </div>
      <div class="col-md-2">
        <input class="form-control" type="number" name="minPrice" placeholder="Min Price" value="<%= query.minPrice || '' %>">
      </div>
      <div class="col-md-2">
        <input class="form-control" type="number" name="maxPrice" placeholder="Max Price" value="<%= query.maxPrice || '' %>">
      </div>
      <div class="col-md-2">
        <select class="form-select" name="rating">
          <option value="">Min Rating</option>
          <% for (let i = 1; i <= 5; i++) { %>
            <option value="<%= i %>" <%= Number(query.rating) === i ? 'selected' : '' %>><%= i %>+</option>
          <% } %>
        </select>
      </div>
      <div class="col-md-2 d-grid">
        <button class="btn btn-primary" type="submit">Search</button>
      </div>
    </form>
  </div>
</div>

<div class="row g-4">
  <% if (!hotels.length) { %>
    <p>No hotels found for selected filters.</p>
  <% } %>

  <% hotels.forEach(hotel => { %>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm hotel-card">
        <img src="<%= hotel.images[0] %>" class="card-img-top" alt="<%= hotel.name %>">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title"><%= hotel.name %></h5>
          <p class="text-muted mb-1">📍 <%= hotel.location %></p>
          <p class="mb-1">⭐ <%= hotel.rating %> / 5</p>
          <p class="fw-bold text-primary">$<%= hotel.price %> / night</p>
          <a href="/hotels/<%= hotel._id %>" class="btn btn-outline-primary mt-auto">View Details</a>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<nav class="mt-4">
  <ul class="pagination">
    <% for (let p = 1; p <= totalPages; p++) { %>
      <li class="page-item <%= p === currentPage ? 'active' : '' %>">
        <a class="page-link" href="/hotels?page=<%= p %>&location=<%= query.location || '' %>&minPrice=<%= query.minPrice || '' %>&maxPrice=<%= query.maxPrice || '' %>&rating=<%= query.rating || '' %>"><%= p %></a>
      </li>
    <% } %>
  </ul>
</nav>
